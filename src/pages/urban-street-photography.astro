---
import BaseLayout from '../layouts/BaseLayout.astro';
import Lightbox from '../components/Lightbox.astro';

const photoCount = 188;
const photos = Array.from({ length: photoCount }, (_, i) => {
	const n = String(i + 1).padStart(3, '0');
	return `/images/gallery/photo-${n}.jpg`;
});
---

<BaseLayout
	title="Urban & Street Photography | Development Tag"
	description="Urban & Street Photography by Development Tag."
>
	<main class="wide">
		<div class="title-row">
			<h1>Urban & Street Photography</h1>
			<a
				class="instagram-link"
				href="https://www.instagram.com/devtagstudiosut"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Follow Devtag Studios Urban & Travel on Instagram"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
					<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
					<line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
				</svg>
			</a>
		</div>

		<Lightbox photos={photos} altPrefix="Urban & street photography" />
	</main>
</BaseLayout>

<style>
	.wide {
		max-width: 1200px;
	}
	.title-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
	}
	.title-row h1 {
		margin-bottom: 0;
	}
	.instagram-link {
		color: #012b55;
		display: inline-flex;
		line-height: 0;
		opacity: 0.85;
	}
	.instagram-link:hover {
		opacity: 1;
	}
</style>
