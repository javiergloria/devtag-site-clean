---
import BaseLayout from '../layouts/BaseLayout.astro';

const photoCount = 40;
const photos = Array.from({ length: photoCount }, (_, i) => {
	const n = String(i + 1).padStart(2, '0');
	return `/images/gallery/photo-${n}.jpg`;
});
---

<BaseLayout
	title="Urban & Street Photography | Development Tag"
	description="Urban & Street Photography by Development Tag."
>
	<main class="wide">
		<h1>Urban & Street Photography</h1>

		<div class="gallery">
			{photos.map((src, i) => (
				<img src={src} alt={`Urban & street photography ${i + 1}`} loading="lazy" />
			))}
		</div>
	</main>
</BaseLayout>

<style>
	.wide {
		max-width: 1200px;
	}
	.gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 0.75rem;
	}
	.gallery img {
		width: 100%;
		height: 280px;
		object-fit: cover;
		border-radius: 4px;
		display: block;
	}
</style>
