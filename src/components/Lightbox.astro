---
interface Props {
	photos: string[];
	altPrefix: string;
}

const { photos, altPrefix } = Astro.props;
---

<div class="gallery">
	{photos.map((src, i) => (
		<img
			class="gallery-thumb"
			src={src}
			alt={`${altPrefix} ${i + 1}`}
			loading="lazy"
			data-index={i}
			data-full={src}
		/>
	))}
</div>

<div class="lightbox" id="lightbox">
	<div class="lightbox-backdrop"></div>
	<button class="lightbox-close" aria-label="Close">&times;</button>
	<button class="lightbox-prev" aria-label="Previous photo">&#8249;</button>
	<img class="lightbox-img" src="" alt="" />
	<button class="lightbox-next" aria-label="Next photo">&#8250;</button>
</div>

<style>
	.gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 0.5rem;
		padding-top: 1rem;
	}
	.gallery-thumb {
		width: 100%;
		height: 300px;
		object-fit: cover;
		display: block;
		cursor: pointer;
		border-radius: 4px;
	}

	.lightbox {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 1000;
		align-items: center;
		justify-content: center;
	}
	.lightbox.open {
		display: flex;
	}
	.lightbox-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.75);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}
	.lightbox-img {
		position: relative;
		max-width: 90vw;
		max-height: 88vh;
		object-fit: contain;
		border-radius: 4px;
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
	}
	.lightbox-close,
	.lightbox-prev,
	.lightbox-next {
		position: absolute;
		background: rgba(0, 0, 0, 0.4);
		color: #fff;
		border: none;
		cursor: pointer;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		line-height: 1;
		z-index: 1001;
	}
	.lightbox-close {
		top: 1.25rem;
		right: 1.25rem;
		width: 2.5rem;
		height: 2.5rem;
		font-size: 1.75rem;
	}
	.lightbox-prev,
	.lightbox-next {
		top: 50%;
		transform: translateY(-50%);
		width: 3rem;
		height: 3rem;
		font-size: 2rem;
	}
	.lightbox-prev {
		left: 1rem;
	}
	.lightbox-next {
		right: 1rem;
	}
	.lightbox-close:hover,
	.lightbox-prev:hover,
	.lightbox-next:hover {
		background: rgba(0, 0, 0, 0.7);
	}
</style>

<script>
	function initLightbox() {
		const thumbs = Array.from(document.querySelectorAll<HTMLImageElement>('.gallery-thumb'));
		const lightbox = document.getElementById('lightbox');
		if (!lightbox || thumbs.length === 0) return;

		const img = lightbox.querySelector<HTMLImageElement>('.lightbox-img')!;
		const closeBtn = lightbox.querySelector<HTMLButtonElement>('.lightbox-close')!;
		const prevBtn = lightbox.querySelector<HTMLButtonElement>('.lightbox-prev')!;
		const nextBtn = lightbox.querySelector<HTMLButtonElement>('.lightbox-next')!;
		const backdrop = lightbox.querySelector<HTMLDivElement>('.lightbox-backdrop')!;

		let currentIndex = 0;

		function show(index: number) {
			currentIndex = (index + thumbs.length) % thumbs.length;
			const full = thumbs[currentIndex].dataset.full || thumbs[currentIndex].src;
			img.src = full;
			img.alt = thumbs[currentIndex].alt;
		}

		function open(index: number) {
			show(index);
			lightbox!.classList.add('open');
			document.body.style.overflow = 'hidden';
		}

		function close() {
			lightbox!.classList.remove('open');
			document.body.style.overflow = '';
		}

		thumbs.forEach((thumb, i) => {
			thumb.addEventListener('click', () => open(i));
		});

		closeBtn.addEventListener('click', close);
		backdrop.addEventListener('click', close);
		prevBtn.addEventListener('click', () => show(currentIndex - 1));
		nextBtn.addEventListener('click', () => show(currentIndex + 1));

		document.addEventListener('keydown', (e) => {
			if (!lightbox!.classList.contains('open')) return;
			if (e.key === 'Escape') close();
			if (e.key === 'ArrowLeft') show(currentIndex - 1);
			if (e.key === 'ArrowRight') show(currentIndex + 1);
		});
	}

	initLightbox();
</script>
